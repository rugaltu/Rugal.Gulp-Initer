<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rugal.Gulp_Initer</RootNamespace>
    <PackageReadmeFile>wwwroot\Gulp-Initer\README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/john2653589/Rugal.Gulp-Initer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <TypeScriptCompile Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <TypeScriptCompile Remove="gulpfile.d.ts" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\gulp-Initer\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
